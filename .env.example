# Copy to .env (make setup). Never commit .env. Production values live in the host's secret manager.

# ── App ──────────────────────────────────────────────
ENVIRONMENT=development            # development | test | staging | production
APP_NAME=Offerlight
PUBLIC_APP_URL=http://localhost:5173
API_CORS_ORIGINS=["http://localhost:5173"]
LOG_LEVEL=INFO
SITE_DOMAIN=localhost              # production: your domain (Caddy gets TLS automatically)

# ── Data stores ──────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://offerlight:offerlight@localhost:5432/offerlight
REDIS_URL=redis://localhost:6379/0

# ── Auth (docs/06-security.md) ───────────────────────
AUTH_CODE_PEPPER=dev-only-change-me   # production: 32+ random bytes (openssl rand -hex 32)
AUTH_CODE_TTL_SECONDS=600
AUTH_CODE_MAX_ATTEMPTS=5
WEBAUTHN_RP_ID=localhost              # production: your registrable domain — decide before Stage 1
WEBAUTHN_RP_NAME=Offerlight
WEBAUTHN_ORIGINS=["http://localhost:5173"]

# ── Bot protection ───────────────────────────────────
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=                   # also exposed to the frontend as VITE_TURNSTILE_SITE_KEY
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=
MIN_FORM_SECONDS=2
RATE_LIMIT_BACKEND=redis

# ── Email ────────────────────────────────────────────
EMAIL_PROVIDER=smtp                   # smtp (Mailpit in dev) | ses (production default) | postmark
EMAIL_FROM=Offerlight <hello@offerlight.localhost>
SMTP_HOST=localhost
SMTP_PORT=1025
POSTMARK_SERVER_TOKEN=
INBOUND_DOMAIN=in.offerlight.localhost
INBOUND_WEBHOOK_SECRET=

# ── Storage (S3-compatible; MinIO in dev) ────────────
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_HOST=http://localhost:9000
S3_BUCKET=offerlight-dev
S3_REGION=eu-west-1
S3_ACCESS_KEY=offerlight
S3_SECRET_KEY=offerlight-dev-secret

# ── AI (writing only; prompts/) ──────────────────────
ANTHROPIC_API_KEY=
AI_MODEL_WRITING=                     # default: a current Haiku-class Claude model id (cheapest that passes evals)
AI_MODEL_STRONG=                      # a Sonnet-class model id, only for features whose evals fail on Haiku
AI_MONTHLY_BUDGET_EUR=200

# ── Billing (Stage 4) ────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_PASS=

# ── Job sources and public data (Stage 5) ────────────
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=
CAREERJET_AFFID=
COMPANIES_HOUSE_API_KEY=

# ── Observability ────────────────────────────────────
# --- Privacy (docs/13-privacy-and-compliance.md) ---
PRIVACY_PSEUDONYM_KEY=dev-only-change-me   # openssl rand -hex 32; keyed hash for retained legal records and erasure tombstones. Never rotate without the runbook.
PRIVACY_CONTACT_EMAIL=privacy@offerlight.localhost

SENTRY_DSN=                          # use the EU data region (https://...@o0.ingest.de.sentry.io/...); PII scrubbing is enforced in code
VITE_# --- Privacy (docs/13-privacy-and-compliance.md) ---
PRIVACY_PSEUDONYM_KEY=dev-only-change-me   # openssl rand -hex 32; keyed hash for retained legal records and erasure tombstones. Never rotate without the runbook.
PRIVACY_CONTACT_EMAIL=privacy@offerlight.localhost

SENTRY_DSN=                          # use the EU data region (https://...@o0.ingest.de.sentry.io/...); PII scrubbing is enforced in code
VITE_ANALYTICS_DOMAIN=

# ── Backups (Tier 0 beta box: docker-compose.beta.yml) ──
BACKUP_S3_ENDPOINT=                   # object storage at a DIFFERENT provider from the server
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_ENCRYPTION_PASSPHRASE=         # openssl rand -hex 32; store it outside the server too
BACKUP_RETENTION_DAYS=30
POSTGRES_PASSWORD=change-me           # beta box only; Tier 1 uses the managed database URL

# ── Deployment (docker-compose.beta.yml / docker-compose.prod.yml) ─
GITHUB_OWNER=
IMAGE_TAG=latest
